# MeshNet setup wrapper settings.
# Copy this file to .env, edit values, then run ./install.sh.
#
# The default DRY_RUN=1 is intentional. Change it to 0 only after reviewing
# the printed setup.sh command and the generated files in ha-mesh-setup-output.

# Home Assistant config directory on the machine where you run install.sh.
# Common values:
#   Home Assistant OS add-on shell: /config
#   Supervised: /usr/share/hassio/homeassistant
#   Docker bind mount on host: /opt/homeassistant/config
#   Core venv: /home/homeassistant/.homeassistant
HA_CONFIG_DIR=/config

# Staging directory for generated config, logs, detection output, and rollback data.
MESHNET_OUTPUT_DIR=./ha-mesh-setup-output

# Safety flags.
DRY_RUN=1
YES=0
VERBOSE=0
INSTALL_CUSTOM_COMPONENT=1

# Gateway endpoints. Leave unused values blank.
# Multiple values can be separated by spaces or commas.
#
# Meshtastic TCP default is usually 4403 when the radio TCP API is enabled.
# 192.0.2.0/24 is reserved for documentation; replace it with your gateway IP.
# Example: WIFI_MESHTASTIC=192.0.2.50:4403
WIFI_MESHTASTIC=

# Prefer stable /dev/serial/by-id paths instead of /dev/ttyUSB0 when available.
# Example: USB_MESHTASTIC=/dev/serial/by-id/usb-YOUR_MESHTASTIC_DEVICE
USB_MESHTASTIC=

# MeshCore ports depend on firmware or bridge configuration. Do not guess.
# Example: WIFI_MESHCORE=192.0.2.51:12345
# Example: USB_MESHCORE=/dev/serial/by-id/usb-YOUR_MESHCORE_DEVICE
WIFI_MESHCORE=
USB_MESHCORE=

# Docker Compose settings.
HA_VERSION=stable
TZ=Etc/UTC
HA_HTTP_PORT=8123
HA_CONFIG_DOCKER=./ha-config
